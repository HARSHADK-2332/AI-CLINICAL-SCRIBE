{
  "name": "scribecare-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "ScribeCare: Ambient AI Clinical Scribe",
  "scripts": {
    "dev:backend": "uvicorn backend.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "test:backend": "python -m pytest tests/",
    "test:frontend": "cd frontend && npm test",
    "test": "npm run test:backend && npm run test:frontend",
    "start": "uvicorn backend.main:app --host 0.0.0.0 --port 8000"
  }
}
